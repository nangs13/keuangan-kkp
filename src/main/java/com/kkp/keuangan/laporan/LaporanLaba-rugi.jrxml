	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="periode" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
        SUM(CASE WHEN code LIKE '401%' THEN ending ELSE 0 END) AS laba_kotor,
        SUM(CASE WHEN code LIKE '501%' THEN ending ELSE 0 END) AS biaya_marketing,
        (SUM(CASE WHEN code LIKE '401%' THEN ending ELSE 0 END)
         - SUM(CASE WHEN code LIKE '501%' THEN ending ELSE 0 END)) AS laba_bersih
    FROM coa
    WHERE periode = $P{periode}]]>
	</queryString>
	<field name="laba_kotor" class="java.lang.Double"/>
	<field name="biaya_marketing" class="java.lang.Double"/>
	<field name="laba_bersih" class="java.lang.Double"/>
