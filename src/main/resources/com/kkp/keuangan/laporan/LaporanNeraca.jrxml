	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="periode" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
        SUM(CASE WHEN code LIKE '101%' THEN ending ELSE 0 END) AS aset,
        SUM(CASE WHEN code LIKE '201%' THEN ending ELSE 0 END) AS kewajiban,
        SUM(CASE WHEN code LIKE '301%' THEN ending ELSE 0 END) AS ekuitas
    FROM coa
    WHERE periode = $P{periode}]]>
	</queryString>
	<field name="aset" class="java.lang.Double"/>
	<field name="kewajiban" class="java.lang.Double"/>
	<field name="ekuitas" class="java.lang.Double"/>
